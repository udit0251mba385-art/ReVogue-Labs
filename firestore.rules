rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'chotusharma4477@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'campusId', 'role', 'dropCredits', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'campusId', 'role', 'dropCredits', 'createdAt', 'updatedAt'])
        && data.uid is string && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.campusId is string && isValidId(data.campusId) && data.campusId.size() <= 64
        && data.role is string && data.role == 'student'
        && data.dropCredits is number && data.dropCredits >= 0 && data.dropCredits <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPickupBooking(data) {
      return data.keys().hasAll([
          'id', 'userId', 'campusId', 'campusName', 'hostelDorm',
          'contactName', 'phone', 'bagSize', 'estimatedItems',
          'estimatedPayout', 'payoutMethod', 'slotDate', 'slotTime',
          'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'campusId', 'campusName', 'hostelDorm',
          'contactName', 'phone', 'upiId', 'bagSize', 'estimatedItems',
          'estimatedPayout', 'payoutMethod', 'slotDate', 'slotTime',
          'status', 'createdAt'
        ])
        && data.id is string && isValidId(data.id) && data.id.size() <= 64
        && data.userId is string && isValidId(data.userId)
        && data.campusId is string && isValidId(data.campusId) && data.campusId.size() <= 64
        && data.campusName is string && data.campusName.size() >= 2 && data.campusName.size() <= 120
        && data.hostelDorm is string && data.hostelDorm.size() >= 2 && data.hostelDorm.size() <= 120
        && data.contactName is string && data.contactName.size() >= 1 && data.contactName.size() <= 80
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 24
        && (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 80))
        && data.bagSize is string && data.bagSize in ['small', 'medium', 'bulk']
        && data.estimatedItems is number && data.estimatedItems >= 1 && data.estimatedItems <= 100
        && data.estimatedPayout is number && data.estimatedPayout >= 0 && data.estimatedPayout <= 100000
        && data.payoutMethod is string && data.payoutMethod in ['upi', 'store_credit']
        && data.slotDate is string && data.slotDate.size() >= 2 && data.slotDate.size() <= 60
        && data.slotTime is string && data.slotTime.size() >= 2 && data.slotTime.size() <= 80
        && data.status is string && data.status in ['scheduled', 'assigned', 'in_transit', 'appraised', 'paid', 'cancelled']
        && data.createdAt is timestamp;
    }

    function isValidThriftOrder(data) {
      return data.keys().hasAll([
          'id', 'userId', 'campusId', 'hostelDorm', 'buyerName',
          'phone', 'paymentType', 'totalAmount', 'totalSavings',
          'itemCount', 'itemTitles', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'campusId', 'hostelDorm', 'buyerName',
          'phone', 'paymentType', 'totalAmount', 'totalSavings',
          'itemCount', 'itemTitles', 'status', 'createdAt'
        ])
        && data.id is string && isValidId(data.id) && data.id.size() <= 64
        && data.userId is string && isValidId(data.userId)
        && data.campusId is string && isValidId(data.campusId) && data.campusId.size() <= 64
        && data.hostelDorm is string && data.hostelDorm.size() >= 2 && data.hostelDorm.size() <= 120
        && data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 80
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 24
        && data.paymentType is string && data.paymentType in ['upi', 'drop_tokens', 'cod']
        && data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 100000
        && data.totalSavings is number && data.totalSavings >= 0 && data.totalSavings <= 200000
        && data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 20
        && data.itemTitles is list && data.itemTitles.size() >= 1 && data.itemTitles.size() <= 20 && data.itemTitles[0] is string && data.itemTitles[0].size() <= 160
        && data.status is string && data.status in ['confirmed', 'packed', 'delivered', 'cancelled']
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // Users Collection (PII strictly isolated to owner or verified admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerifiedUser() && request.auth.token.email == 'chotusharma4477@gmail.com';
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && isOwner(userId)
        && incoming().uid == request.auth.uid
        && incoming().role == 'student'
        && incoming().dropCredits == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'campusId', 'updatedAt'])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'campusId', 'dropCredits', 'updatedAt']))
        );
      allow delete: if false;
    }

    // Pickup Bookings Collection
    match /pickupBookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (isVerifiedUser() && request.auth.token.email == 'chotusharma4477@gmail.com')
      );
      allow create: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidPickupBooking(incoming())
        && incoming().id == bookingId
        && incoming().userId == request.auth.uid
        && incoming().status == 'scheduled'
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidPickupBooking(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && existing().status != 'paid'
        && existing().status != 'cancelled'
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
          (existing().userId == request.auth.uid && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
        );
      allow delete: if false;
    }

    // Thrift Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (isVerifiedUser() && request.auth.token.email == 'chotusharma4477@gmail.com')
      );
      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidThriftOrder(incoming())
        && incoming().id == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'confirmed'
        && incoming().createdAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(orderId)
        && isValidThriftOrder(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && existing().status != 'delivered'
        && existing().status != 'cancelled'
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
          (existing().userId == request.auth.uid && incoming().status == 'cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
        );
      allow delete: if false;
    }
  }
}
